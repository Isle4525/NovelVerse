<!doctype html>
<html lang="ru" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NovelVerse — Регистрация</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.263.0/dist/umd/lucide.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;600;800&family=Nunito+Sans:wght@400;600;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: { extend: { fontFamily: { heading: ['Unbounded','sans-serif'], body: ['Nunito Sans','sans-serif'] } } }
    }
  </script>
  <style>
    html, body { height: 100%; margin: 0; box-sizing: border-box; }
    * { box-sizing: border-box; }

    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: #0d0d14; }
    ::-webkit-scrollbar-thumb { background: #2a2a3d; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #ff3e6c; }

    .input-field {
      width: 100%; padding: 14px 16px; border-radius: 10px; font-size: 14px;
      outline: none; transition: border-color 0.2s, box-shadow 0.2s;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      color: #fff;
    }
    .input-field:focus {
      border-color: rgba(255,62,108,0.5);
      box-shadow: 0 0 0 3px rgba(255,62,108,0.1);
    }
    .input-field::placeholder { color: rgba(255,255,255,0.25); }
    .input-field.error { border-color: rgba(255,62,108,0.6); }

    .btn-primary {
      width: 100%; padding: 14px; border-radius: 10px; font-weight: 700;
      font-size: 14px; cursor: pointer; transition: background 0.2s, transform 0.1s;
      background: #ff3e6c; color: #fff; border: none;
    }
    .btn-primary:hover { background: #e0355f; }
    .btn-primary:active { transform: scale(0.98); }
    .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; }

    .card {
      background: #1a1a2e;
      border: 1px solid rgba(255,62,108,0.15);
      border-radius: 20px;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .fade-up { animation: fadeUp 0.5s ease forwards; }

    .orb1 {
      position: fixed; width: 400px; height: 400px; border-radius: 50%;
      background: radial-gradient(circle, rgba(255,62,108,0.12) 0%, transparent 70%);
      top: -100px; left: -100px; pointer-events: none;
    }
    .orb2 {
      position: fixed; width: 350px; height: 350px; border-radius: 50%;
      background: radial-gradient(circle, rgba(124,58,237,0.1) 0%, transparent 70%);
      bottom: -80px; right: -80px; pointer-events: none;
    }

    .divider { display: flex; align-items: center; gap: 12px; margin: 20px 0; }
    .divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: rgba(255,255,255,0.08); }

    .strength-bar { height: 3px; border-radius: 2px; transition: width 0.3s, background 0.3s; }

    .error-msg {
      display: none; padding: 12px 16px; border-radius: 10px; font-size: 13px; margin-bottom: 16px;
      background: rgba(255,62,108,0.1); border: 1px solid rgba(255,62,108,0.25);
      color: #ff6b8a;
    }

    .password-hint { font-size: 11px; color: rgba(255,255,255,0.3); margin-top: 6px; }

    .checkbox-wrap {
      display: flex; align-items: flex-start; gap: 10px; cursor: pointer;
    }
    .checkbox-wrap input[type="checkbox"] { accent-color: #ff3e6c; margin-top: 2px; width: 15px; height: 15px; flex-shrink: 0; }

    /* CODE INPUT */
    .code-inputs { display: flex; gap: 10px; justify-content: center; margin: 24px 0; }
    .code-input {
      width: 52px; height: 60px; text-align: center; font-size: 24px; font-weight: 700;
      border-radius: 12px; outline: none; transition: border-color 0.2s, box-shadow 0.2s;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      color: #fff; caret-color: #ff3e6c;
    }
    .code-input:focus {
      border-color: rgba(255,62,108,0.6);
      box-shadow: 0 0 0 3px rgba(255,62,108,0.15);
    }
    .code-input.filled { border-color: rgba(255,62,108,0.4); }
    .code-input.shake { animation: shake 0.4s ease; }

    @keyframes shake {
      0%,100% { transform: translateX(0); }
      20%      { transform: translateX(-6px); }
      40%      { transform: translateX(6px); }
      60%      { transform: translateX(-4px); }
      80%      { transform: translateX(4px); }
    }

    /* TIMER */
    #resend-timer { font-size: 13px; color: rgba(255,255,255,0.35); text-align: center; margin-top: 12px; }
    #resend-btn { display: none; font-size: 13px; color: #ff3e6c; background: none; border: none; cursor: pointer; text-align: center; width: 100%; margin-top: 12px; font-weight: 600; }
    #resend-btn:hover { color: #ff6b8a; }
  </style>
</head>
<body class="h-full font-body" style="background:#0d0d14; color:#e0dfe4;">

  <div class="orb1"></div>
  <div class="orb2"></div>

  <!-- NAV -->
  <nav class="sticky top-0 z-50 w-full border-b border-white/5" style="background:rgba(13,13,20,0.92); backdrop-filter:blur(16px);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between h-14">
      <a href="/index.html" class="font-heading font-extrabold text-lg tracking-tight" style="color:#ff3e6c;">NovelVerse</a>
      <div class="flex items-center gap-3 text-sm text-white/50">
        Уже есть аккаунт?
        <a href="/login.html" class="font-semibold transition" style="color:#ff3e6c;">Войти</a>
      </div>
    </div>
  </nav>

  <!-- MAIN -->
  <main class="flex items-center justify-center min-h-[calc(100vh-56px)] px-4 py-12">
    <div class="w-full max-w-md fade-up">

      <!-- ========== SCREEN 1: REGISTER FORM ========== -->
      <div id="screen-register">
        <div class="text-center mb-8">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl mb-4" style="background:rgba(255,62,108,0.1); border:1px solid rgba(255,62,108,0.2);">
            <i data-lucide="user-plus" style="width:28px;height:28px;color:#ff3e6c;"></i>
          </div>
          <h1 class="font-heading font-extrabold text-2xl mb-2" style="color:#fff;">Создать аккаунт</h1>
          <p style="color:rgba(255,255,255,0.45); font-size:14px;">Присоединяйся к 1.5M+ читателей</p>
        </div>

        <div class="card p-8">
          <div id="error-reg" class="error-msg"></div>

          <form id="register-form" novalidate>
            <div class="mb-4">
              <label class="block text-xs font-semibold mb-2" style="color:rgba(255,255,255,0.5);">Имя пользователя</label>
              <div class="relative">
                <input id="username" type="text" class="input-field" placeholder="YourNickname" autocomplete="username" style="padding-right:44px;">
                <i data-lucide="at-sign" style="position:absolute;right:14px;top:50%;transform:translateY(-50%);width:16px;height:16px;color:rgba(255,255,255,0.2);pointer-events:none;"></i>
              </div>
              <p class="password-hint">Только буквы, цифры и _ (от 3 до 50 символов)</p>
            </div>

            <div class="mb-4">
              <label class="block text-xs font-semibold mb-2" style="color:rgba(255,255,255,0.5);">Email</label>
              <div class="relative">
                <input id="email" type="email" class="input-field" placeholder="your@email.com" autocomplete="email" style="padding-right:44px;">
                <i data-lucide="mail" style="position:absolute;right:14px;top:50%;transform:translateY(-50%);width:16px;height:16px;color:rgba(255,255,255,0.2);pointer-events:none;"></i>
              </div>
            </div>

            <div class="mb-4">
              <label class="block text-xs font-semibold mb-2" style="color:rgba(255,255,255,0.5);">Пароль</label>
              <div class="relative">
                <input id="password" type="password" class="input-field" placeholder="••••••••" autocomplete="new-password" style="padding-right:44px;" oninput="checkStrength(this.value)">
                <button type="button" onclick="togglePassword('password','eye1')" style="position:absolute;right:14px;top:50%;transform:translateY(-50%);color:rgba(255,255,255,0.2);background:none;border:none;cursor:pointer;padding:0;">
                  <i id="eye1" data-lucide="eye" style="width:16px;height:16px;"></i>
                </button>
              </div>
              <div class="flex gap-1 mt-2">
                <div id="s1" class="strength-bar flex-1" style="background:rgba(255,255,255,0.08);"></div>
                <div id="s2" class="strength-bar flex-1" style="background:rgba(255,255,255,0.08);"></div>
                <div id="s3" class="strength-bar flex-1" style="background:rgba(255,255,255,0.08);"></div>
                <div id="s4" class="strength-bar flex-1" style="background:rgba(255,255,255,0.08);"></div>
              </div>
              <p id="strength-label" class="password-hint mt-1">Минимум 6 символов</p>
            </div>

            <div class="mb-6">
              <label class="block text-xs font-semibold mb-2" style="color:rgba(255,255,255,0.5);">Подтверждение пароля</label>
              <div class="relative">
                <input id="confirmPassword" type="password" class="input-field" placeholder="••••••••" autocomplete="new-password" style="padding-right:44px;">
                <button type="button" onclick="togglePassword('confirmPassword','eye2')" style="position:absolute;right:14px;top:50%;transform:translateY(-50%);color:rgba(255,255,255,0.2);background:none;border:none;cursor:pointer;padding:0;">
                  <i id="eye2" data-lucide="eye" style="width:16px;height:16px;"></i>
                </button>
              </div>
            </div>

            <label class="checkbox-wrap mb-6">
              <input type="checkbox" id="terms">
              <span style="font-size:13px; color:rgba(255,255,255,0.5); line-height:1.5;">
                Я принимаю <a href="#" style="color:#ff3e6c; font-weight:600;">условия использования</a> и <a href="#" style="color:#ff3e6c; font-weight:600;">политику конфиденциальности</a>
              </span>
            </label>

            <button type="submit" class="btn-primary" id="submit-btn">Создать аккаунт</button>
          </form>

          <div class="divider"><span style="font-size:12px;color:rgba(255,255,255,0.2);">или</span></div>
          <p class="text-center text-sm" style="color:rgba(255,255,255,0.4);">
            Уже есть аккаунт?
            <a href="/login.html" class="font-semibold transition" style="color:#ff3e6c;" onmouseenter="this.style.color='#ff6b8a'" onmouseleave="this.style.color='#ff3e6c'">Войти</a>
          </p>
        </div>

        <div class="text-center mt-6">
          <a href="/index.html" class="inline-flex items-center gap-2 text-sm transition" style="color:rgba(255,255,255,0.3);" onmouseenter="this.style.color='rgba(255,255,255,0.6)'" onmouseleave="this.style.color='rgba(255,255,255,0.3)'">
            <i data-lucide="arrow-left" style="width:14px;height:14px;"></i>
            Вернуться на главную
          </a>
        </div>
      </div>

      <!-- ========== SCREEN 2: CODE VERIFICATION ========== -->
      <div id="screen-verify" style="display:none;">
        <div class="text-center mb-8">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl mb-4" style="background:rgba(34,211,238,0.1); border:1px solid rgba(34,211,238,0.25);">
            <i data-lucide="mail" style="width:28px;height:28px;color:#22d3ee;"></i>
          </div>
          <h1 class="font-heading font-extrabold text-2xl mb-2" style="color:#fff;">Введи код</h1>
          <p style="color:rgba(255,255,255,0.45); font-size:14px;">
            Мы отправили 6-значный код на<br>
            <span id="email-display" style="color:#fff; font-weight:600;"></span>
          </p>
        </div>

        <div class="card p-8">
          <div id="error-verify" class="error-msg"></div>

          <!-- 6 code boxes -->
          <div class="code-inputs">
            <input class="code-input" type="text" inputmode="numeric" maxlength="1" id="c0">
            <input class="code-input" type="text" inputmode="numeric" maxlength="1" id="c1">
            <input class="code-input" type="text" inputmode="numeric" maxlength="1" id="c2">
            <input class="code-input" type="text" inputmode="numeric" maxlength="1" id="c3">
            <input class="code-input" type="text" inputmode="numeric" maxlength="1" id="c4">
            <input class="code-input" type="text" inputmode="numeric" maxlength="1" id="c5">
          </div>

          <button class="btn-primary" id="verify-btn" onclick="submitCode()">Подтвердить</button>

          <div id="resend-timer">Отправить повторно через <span id="timer-count">60</span> сек</div>
          <button id="resend-btn" onclick="resendCode()">Отправить код повторно</button>

          <div class="mt-4 text-center">
            <button onclick="backToRegister()" class="text-sm transition" style="color:rgba(255,255,255,0.3);" onmouseenter="this.style.color='rgba(255,255,255,0.6)'" onmouseleave="this.style.color='rgba(255,255,255,0.3)'">
              ← Изменить email
            </button>
          </div>
        </div>
      </div>

      <!-- ========== SCREEN 3: SUCCESS ========== -->
      <div id="screen-success" style="display:none;">
        <div class="text-center mb-8">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl mb-4" style="background:rgba(34,211,238,0.1); border:1px solid rgba(34,211,238,0.25);">
            <i data-lucide="check-circle" style="width:28px;height:28px;color:#22d3ee;"></i>
          </div>
          <h1 class="font-heading font-extrabold text-2xl mb-2" style="color:#fff;">Email подтверждён! 🎉</h1>
          <p style="color:rgba(255,255,255,0.45); font-size:14px;">Аккаунт активирован. Можешь войти.</p>
        </div>
        <div class="card p-8 text-center">
          <a href="/login.html" class="btn-primary" style="display:inline-block; text-decoration:none; text-align:center;">
            Войти в аккаунт
          </a>
        </div>
      </div>

    </div>
  </main>

  <script>
    lucide.createIcons();

    if (localStorage.getItem('accessToken')) {
      window.location.href = '/index.html';
    }

    let registeredEmail = '';
    let timerInterval   = null;

    // ---- HELPERS ----
    function togglePassword(inputId, iconId) {
      const input = document.getElementById(inputId);
      const icon  = document.getElementById(iconId);
      input.type  = input.type === 'password' ? 'text' : 'password';
      icon.setAttribute('data-lucide', input.type === 'password' ? 'eye' : 'eye-off');
      lucide.createIcons();
    }

    function checkStrength(val) {
      const bars   = ['s1','s2','s3','s4'].map(id => document.getElementById(id));
      const label  = document.getElementById('strength-label');
      const colors = ['#ff3e6c','#ff8c42','#f5c518','#22d3ee'];
      const labels = ['Слабый','Средний','Хороший','Отличный'];
      let score = 0;
      if (val.length >= 6)  score++;
      if (val.length >= 10) score++;
      if (/[A-Z]/.test(val) && /[0-9]/.test(val)) score++;
      if (/[^A-Za-z0-9]/.test(val)) score++;
      bars.forEach((b, i) => {
        b.style.background = i < score ? colors[score - 1] : 'rgba(255,255,255,0.08)';
      });
      label.textContent = val.length === 0 ? 'Минимум 6 символов' : (score > 0 ? labels[score - 1] : 'Слишком короткий');
      label.style.color = val.length === 0 ? 'rgba(255,255,255,0.3)' : colors[Math.max(0, score - 1)];
    }

    function showError(id, msg) {
      const el = document.getElementById(id);
      el.textContent = msg;
      el.style.display = 'block';
    }
    function hideError(id) { document.getElementById(id).style.display = 'none'; }

    function showScreen(name) {
      ['screen-register','screen-verify','screen-success'].forEach(s => {
        document.getElementById(s).style.display = s === 'screen-' + name ? 'block' : 'none';
      });
      lucide.createIcons();
    }

    // ---- REGISTER SUBMIT ----
    document.getElementById('register-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      hideError('error-reg');

      const username        = document.getElementById('username').value.trim();
      const email           = document.getElementById('email').value.trim();
      const password        = document.getElementById('password').value;
      const confirmPassword = document.getElementById('confirmPassword').value;
      const terms           = document.getElementById('terms').checked;

      if (!username || !email || !password || !confirmPassword) { showError('error-reg', 'Пожалуйста, заполните все поля'); return; }
      if (password !== confirmPassword) { showError('error-reg', 'Пароли не совпадают'); return; }
      if (!terms) { showError('error-reg', 'Необходимо принять условия использования'); return; }

      const btn = document.getElementById('submit-btn');
      btn.textContent = 'Создаём аккаунт...'; btn.disabled = true;

      try {
        const res  = await fetch('http://localhost:8080/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, email, password, confirmPassword })
        });
        const data = await res.json();

        if (res.ok) {
          registeredEmail = email;
          document.getElementById('email-display').textContent = email;
          showScreen('verify');
          startTimer();
          setTimeout(() => document.getElementById('c0').focus(), 100);
        } else {
          const msg = typeof data.message === 'object'
            ? Object.values(data.message).join('\n')
            : (data.message || 'Ошибка регистрации');
          showError('error-reg', msg);
        }
      } catch (err) {
        showError('error-reg', 'Сервер недоступен. Убедись что бэкенд запущен.');
      } finally {
        btn.textContent = 'Создать аккаунт'; btn.disabled = false;
      }
    });

    // ---- CODE INPUT BEHAVIOUR ----
    const codeInputs = Array.from({length: 6}, (_, i) => document.getElementById('c' + i));

    codeInputs.forEach((input, idx) => {
      input.addEventListener('input', (e) => {
        const val = e.target.value.replace(/\D/g, '');
        e.target.value = val;
        if (val) {
          e.target.classList.add('filled');
          if (idx < 5) codeInputs[idx + 1].focus();
          // auto-submit when last digit entered
          if (idx === 5) submitCode();
        } else {
          e.target.classList.remove('filled');
        }
      });

      input.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && !e.target.value && idx > 0) {
          codeInputs[idx - 1].focus();
          codeInputs[idx - 1].value = '';
          codeInputs[idx - 1].classList.remove('filled');
        }
      });

      // handle paste
      input.addEventListener('paste', (e) => {
        e.preventDefault();
        const paste = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '').slice(0, 6);
        paste.split('').forEach((ch, i) => {
          if (codeInputs[i]) {
            codeInputs[i].value = ch;
            codeInputs[i].classList.add('filled');
          }
        });
        if (paste.length === 6) submitCode();
        else if (codeInputs[paste.length]) codeInputs[paste.length].focus();
      });
    });

    // ---- VERIFY CODE ----
    async function submitCode() {
      hideError('error-verify');
      const code = codeInputs.map(i => i.value).join('');
      if (code.length < 6) { showError('error-verify', 'Введи все 6 цифр кода'); return; }

      const btn = document.getElementById('verify-btn');
      btn.textContent = 'Проверяем...'; btn.disabled = true;

      try {
        const res  = await fetch('http://localhost:8080/api/auth/verify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: registeredEmail, code })
        });
        const data = await res.json();

        if (res.ok) {
          clearInterval(timerInterval);
          showScreen('success');
        } else {
          showError('error-verify', data.message || 'Неверный код');
          codeInputs.forEach(i => { i.classList.add('shake'); i.value = ''; i.classList.remove('filled'); });
          setTimeout(() => codeInputs.forEach(i => i.classList.remove('shake')), 400);
          codeInputs[0].focus();
        }
      } catch (err) {
        showError('error-verify', 'Сервер недоступен.');
      } finally {
        btn.textContent = 'Подтвердить'; btn.disabled = false;
      }
    }

    // ---- TIMER ----
    function startTimer() {
      let seconds = 60;
      document.getElementById('resend-timer').style.display = 'block';
      document.getElementById('resend-btn').style.display   = 'none';
      document.getElementById('timer-count').textContent     = seconds;

      clearInterval(timerInterval);
      timerInterval = setInterval(() => {
        seconds--;
        document.getElementById('timer-count').textContent = seconds;
        if (seconds <= 0) {
          clearInterval(timerInterval);
          document.getElementById('resend-timer').style.display = 'none';
          document.getElementById('resend-btn').style.display   = 'block';
        }
      }, 1000);
    }

    // ---- RESEND ----
    async function resendCode() {
      const btn = document.getElementById('resend-btn');
      btn.textContent = 'Отправляем...'; btn.disabled = true;

      try {
        await fetch('http://localhost:8080/api/auth/resend', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: registeredEmail })
        });
        codeInputs.forEach(i => { i.value = ''; i.classList.remove('filled'); });
        codeInputs[0].focus();
        startTimer();
      } catch (err) {
        showError('error-verify', 'Не удалось отправить код.');
      } finally {
        btn.textContent = 'Отправить код повторно'; btn.disabled = false;
      }
    }

    function backToRegister() {
      clearInterval(timerInterval);
      codeInputs.forEach(i => { i.value = ''; i.classList.remove('filled'); });
      hideError('error-verify');
      showScreen('register');
    }
  </script>
</body>
</html>
